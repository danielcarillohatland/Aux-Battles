# AUX BATTLES — environment template. Copy to .env and fill in real values.
# NEVER commit .env or real secrets (TDD §10 item 7: env-only secrets).

# Spotify app credentials — https://developer.spotify.com/dashboard
# Dev Mode: host account must be allowlisted on the app (5-user cap).
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/v1/spotify/callback

# Optional 32-byte key for encrypting Spotify tokens at rest (aes-256-gcm).
# Accepts 64 hex chars or base64 of exactly 32 bytes; if unset, a key is
# derived from SPOTIFY_CLIENT_SECRET via scrypt.
AUX_TOKEN_KEY=

# SQLite checkpoint file ('' → ':memory:' in tests).
AUX_DB_FILE=

# Analytics NDJSON sink path (D-010). Unset disables persistence.
AUX_ANALYTICS_FILE=

# Server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Dev-only debug dashboard (D-011) — '1' enables; never set in production.
AUX_DEV_MODE=

# AUX BATTLES — environment template. Copy to .env and fill in real values.
# NEVER commit .env or real secrets (TDD §10 item 7: env-only secrets).

# Optional: add official Apple Music catalog search and in-app playback. Leave
# these blank for the default zero-setup flow, where players enter any title
# and artist and the host opens it in their preferred music service.
AUX_APPLE_MUSIC_DEVELOPER_TOKEN=
AUX_APPLE_MUSIC_STOREFRONT=no

# Optional song search through the YouTube Data
# API and playback of the official embedded player on the host screen. Free
# key from Google Cloud (YouTube Data API v3). Default quota covers ~100
# searches/day; request the free quota extension before launch. See
# docs/youtube-music.md and docs/RELEASE-READINESS.md. A key does not clear music
# rights or certify the app for commercial use. Region is a two-letter code.
AUX_YOUTUBE_API_KEY=
AUX_YOUTUBE_REGION=
# Song gallery for player search (metadata only, no key): on by default. Picks
# resolve to the best YouTube video when a key exists, otherwise the host plays
# them manually. Set 0 to search YouTube videos directly instead.
AUX_SONG_SEARCH=

# Optional playtest-only catalog: 30-second preview clips from Deezer's public
# API (no key). Off unless set to 1. Deezer's developer terms are
# non-commercial; read docs/deezer-music.md before enabling it anywhere public.
AUX_DEEZER_PREVIEWS=

# Optional publisher-controlled audio must be licensed for games, apps,
# commercial distribution, excerpts, and the intended territories.
AUX_LICENSED_MUSIC_MANIFEST=
AUX_LICENSED_MUSIC_ROOT=

# Legacy/test-only escape hatch. Product builds should leave this disabled.
AUX_ENABLE_ORIGINALS=

# Live AI judge (required for real AI scores). Without a key, the lobby and
# verdicts offer crowd voting. See docs/ai-judge.md.
# Limits below count actual API attempts per process, including retries;
# configure a provider-side credit cap as well (restarts reset these counters).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
AUX_LLM_MAX_CALLS=1000
AUX_LLM_MAX_CONCURRENT=8
# Who gets the AI judge: 'open' (default) = every host, free, no sign-in;
# 'account' = signed-in iOS hosts spending game credits (docs/billing.md).
AUX_AI_ACCESS=open
# Site-wide cap on free AI games per UTC day; later games use crowd voting.
AUX_OPEN_AI_DAILY_GAMES=30
# Hard spending caps in micro-dollars (1,000,000 = $1), enforced durably in SQLite.
AUX_AI_DAILY_BUDGET_MICROS=500000
AUX_AI_MONTHLY_BUDGET_MICROS=3000000

# Durable SQLite room checkpoints. Production requires an explicit file path.
AUX_DB_FILE=

# Analytics NDJSON sink path (D-010). Unset disables persistence.
AUX_ANALYTICS_FILE=

# Server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Number of trusted reverse-proxy hops (Fly.io = 1) so per-IP limits use the
# address the proxy appended, not a client-supplied X-Forwarded-For entry.
# Leave empty when exposing Fastify directly.
AUX_TRUST_PROXY=

# Extra comma-separated web origins allowed to call the production API.
# Capacitor's local iOS/Android origins are allowed automatically.
AUX_ALLOWED_ORIGINS=

# Public publisher details shown under "Help & privacy" (GET /api/v1/app-config).
# Links must be public HTTPS URLs; the iOS release check requires all four.
AUX_PUBLISHER_NAME=
AUX_PRIVACY_URL=
AUX_TERMS_URL=
AUX_SUPPORT_URL=

# Dev-only debug dashboard (D-011) — '1' enables; never set in production.
AUX_DEV_MODE=

# Commercial AI allowance and App Store hosts. All billing decisions stay on
# the server. See docs/billing.md. USD millionths: 1000000 = $1.
# Billing records use the persistent application SQLite database.
AUX_AI_DAILY_BUDGET_MICROS=5000000
AUX_AI_MONTHLY_BUDGET_MICROS=30000000
# Worst-case reservation for EACH network attempt, including retries/backup.
# Review against every model's input/output limits, reasoning and fees.
AUX_AI_ATTEMPT_MAX_MICROS=10000
AUX_HOST_DAILY_GAMES=10
AUX_TRIAL_GAME_CREDITS=1
# This release supports exactly five rounds per game credit.
AUX_GAME_MAX_ROUNDS=5

# Production sign-in is disabled until all authorization settings are present.
AUX_APPLE_BUNDLE_ID=
AUX_APPLE_SIGN_IN_AUDIENCE=
AUX_APPLE_TEAM_ID=
AUX_APPLE_SIGN_IN_KEY_ID=
AUX_APPLE_SIGN_IN_PRIVATE_KEY_FILE=
# Base64-encoded random 32-byte key; durable secret, never ship in an app bundle.
AUX_APPLE_REFRESH_ENCRYPTION_KEY=
# App Store verification. Sandbox is rejected by a production server.
AUX_APPLE_ENVIRONMENT=Production
AUX_APPLE_APP_ID=
AUX_APPLE_ROOT_CERT_FILES=
# Consumable product IDs => credits. Configure real products in App Store Connect.
AUX_APPLE_GAME_PRODUCTS={}

# Optional read-only operational metrics endpoint; keep this token server-side.
# AUX_OPERATIONS_TOKEN=<random secret with at least 32 characters>
